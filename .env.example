# Server / runtime
PORT=8080
GIN_MODE=release
ENVIRONMENT=production
BASE_URL=https://clpr.tv
LOG_LEVEL=info
EXPORT_DIR=./exports
DOCS_PATH=../docs

# Database
DB_HOST=pg17-clustr
DB_PORT=5432
DB_USER=clpr
DB_PASSWORD=
DB_NAME=clpr_db
DB_SSLMODE=disable

# Redis
REDIS_HOST=projects-redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth / JWT / security
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
MFA_ENCRYPTION_KEY=

# Twitch OAuth / API
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=https://clpr.tv/api/v1/twitch/oauth/callback

# HTTP / browser origins
CORS_ALLOWED_ORIGINS=https://clpr.tv
WEBSOCKET_ALLOWED_ORIGINS=https://clpr.tv

# OpenSearch
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INSECURE_SKIP_VERIFY=true

# Llama-line / embeddings
# llama-line requires Authorization: Bearer <key> and returns SSE-wrapped embedding JSON.
LLAMA_LINE_API_KEY=
OPENAI_API_KEY=
EMBEDDING_ENABLED=true
EMBEDDING_API_BASE_URL=http://10.0.0.50:11434/v1/embeddings
EMBEDDING_MODEL=nomic-embed-text:v1.5
EMBEDDING_REQUESTS_PER_MINUTE=1000
EMBEDDING_SCHEDULER_INTERVAL_MINUTES=360

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_ALT=
STRIPE_WEBHOOK_SECRETS=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_CENTS=999
STRIPE_PRO_YEARLY_PRICE_CENTS=9999
STRIPE_SUCCESS_URL=https://clpr.tv/subscription/success
STRIPE_CANCEL_URL=https://clpr.tv/subscription/cancel
STRIPE_TAX_ENABLED=false
STRIPE_INVOICE_PDF_ENABLED=false

# Email / SendGrid
EMAIL_ENABLED=false
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_PUBLIC_KEY=
EMAIL_FROM_ADDRESS=noreply@clpr.tv
EMAIL_FROM_NAME=clpr
EMAIL_MAX_PER_HOUR=10
EMAIL_SANDBOX_MODE=false

# Sentry
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=1.0

# Feature flags
FEATURE_SEMANTIC_SEARCH=true
FEATURE_PREMIUM_SUBSCRIPTIONS=false
FEATURE_EMAIL_NOTIFICATIONS=false
FEATURE_PUSH_NOTIFICATIONS=false
FEATURE_ANALYTICS=true
FEATURE_MODERATION=true
FEATURE_DISCOVERY_LISTS=false

# Karma / submissions
KARMA_INITIAL_POINTS=100
KARMA_SUBMISSION_REQUIRED=100
KARMA_REQUIRE_FOR_SUBMISSION=true

# Background jobs
HOT_CLIPS_REFRESH_INTERVAL_MINUTES=5
WEBHOOK_RETRY_INTERVAL_MINUTES=1
WEBHOOK_RETRY_BATCH_SIZE=100

# Rate limits
RATE_LIMIT_UNAUTH_REQUESTS=100
RATE_LIMIT_UNAUTH_WINDOW_MINUTES=15
RATE_LIMIT_BASIC_REQUESTS=1000
RATE_LIMIT_PREMIUM_REQUESTS=5000
RATE_LIMIT_CLIPS_LIST=100
RATE_LIMIT_CLIPS_CREATE=10
RATE_LIMIT_FEED=30
RATE_LIMIT_USER_PROFILE=200
RATE_LIMIT_COMMENT_CREATE=10
RATE_LIMIT_VOTE=20
RATE_LIMIT_FOLLOW=20
RATE_LIMIT_SUBMISSION=5
RATE_LIMIT_REPORT=10
RATE_LIMIT_EXPORT=1
RATE_LIMIT_ACCOUNT_DELETION=1
RATE_LIMIT_WHITELIST_IPS=

# Query/search limits
QUERY_MAX_RESULT_SIZE=1000
QUERY_MAX_OFFSET=1000
QUERY_MAX_JOIN_DEPTH=3
QUERY_MAX_TIME_SEC=10
SEARCH_MAX_RESULT_SIZE=100
SEARCH_MAX_AGGREGATION_SIZE=100
SEARCH_MAX_AGGREGATION_NEST=2
SEARCH_MAX_QUERY_CLAUSES=20
SEARCH_MAX_TIME_SEC=5
SEARCH_MAX_OFFSET=1000

# CDN / media storage
CDN_ENABLED=false
CDN_PROVIDER=cloudflare
CDN_CLOUDFLARE_ZONE_ID=
CDN_CLOUDFLARE_API_KEY=
CDN_BUNNY_API_KEY=
CDN_BUNNY_STORAGE_ZONE=
CDN_AWS_ACCESS_KEY_ID=
CDN_AWS_SECRET_KEY=
CDN_AWS_REGION=us-east-1
CDN_CACHE_TTL=3600
CDN_MAX_COST_PER_GB=0.10
CLIP_STORAGE_PROVIDER=s3
CLIP_STORAGE_ENDPOINT=
CLIP_STORAGE_REGION=us-east-1
CLIP_STORAGE_BUCKET=
CLIP_STORAGE_ACCESS_KEY=
CLIP_STORAGE_SECRET_KEY=
CLIP_STORAGE_FORCE_PATH_STYLE=true
CLIP_STORAGE_PUBLIC_BASE_URL=
CLIP_MEDIA_PUBLIC_BASE_URL=
CLIP_MAX_UPLOAD_BYTES=524288000
CLIP_MAX_DURATION_SECONDS=60
CLIP_RECOMMENDED_DURATION_SECONDS=30
CLIP_ALLOWED_UPLOAD_MIME_TYPES=video/mp4,video/webm,video/quicktime
CLIP_REQUIRE_MODERATION_FOR_UPLOAD=true

# Mirror / recommendations / hybrid search tuning
MIRROR_ENABLED=false
MIRROR_REGIONS=us-east-1,eu-west-1,ap-southeast-1
MIRROR_REPLICATION_THRESHOLD=1000
MIRROR_TTL_DAYS=7
MIRROR_MAX_PER_CLIP=3
MIRROR_SYNC_INTERVAL_MINUTES=60
MIRROR_CLEANUP_INTERVAL_MINUTES=1440
MIRROR_MIN_HIT_RATE=60.0
REC_CONTENT_WEIGHT=0.5
REC_COLLABORATIVE_WEIGHT=0.3
REC_TRENDING_WEIGHT=0.2
REC_CF_FACTORS=50
REC_CF_REGULARIZATION=0.01
REC_CF_LEARNING_RATE=0.01
REC_CF_ITERATIONS=20
REC_TRENDING_WINDOW_DAYS=7
REC_TRENDING_MIN_SCORE=0.0
REC_POPULARITY_WINDOW_DAYS=30
REC_POPULARITY_MIN_VIEWS=100
REC_ENABLE_HYBRID=true
REC_CACHE_TTL_HOURS=24
HYBRID_SEARCH_BM25_WEIGHT=0.7
HYBRID_SEARCH_VECTOR_WEIGHT=0.3
HYBRID_SEARCH_TITLE_BOOST=3.0
HYBRID_SEARCH_CREATOR_BOOST=2.0
HYBRID_SEARCH_GAME_BOOST=1.0
HYBRID_SEARCH_ENGAGEMENT_BOOST=0.1
HYBRID_SEARCH_RECENCY_BOOST=0.5

# Moderation / safety integrations
TOXICITY_ENABLED=false
TOXICITY_API_KEY=
TOXICITY_API_URL=https://commentanalyzer.googleapis.com/v1alpha1/comments:analyze
TOXICITY_THRESHOLD=0.85
NSFW_ENABLED=false
NSFW_API_KEY=
NSFW_API_URL=
NSFW_THRESHOLD=0.80
NSFW_SCAN_THUMBNAILS=true
NSFW_AUTO_FLAG=true
NSFW_MAX_LATENCY_MS=200
NSFW_TIMEOUT_SECONDS=5

# Telemetry
TELEMETRY_ENABLED=false
TELEMETRY_SERVICE_NAME=clpr-backend
TELEMETRY_SERVICE_VERSION=
TELEMETRY_OTLP_ENDPOINT=localhost:4317
TELEMETRY_INSECURE=true
TELEMETRY_TRACES_SAMPLE_RATE=0.1
TELEMETRY_ENVIRONMENT=production

# Chat
CHAT_RATE_LIMIT_PER_MINUTE=60
CHAT_RATE_LIMIT_BURST=10

# Test-only helpers
TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=6380
