# Copy to .env for local development only. Never commit populated secrets.
# Release profiles require HTTPS, durable object storage, verified database TLS,
# and externally managed credentials; see config/validate.go.

ENVIRONMENT=development
GIN_MODE=debug
PORT=8080
BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=clpr
DB_USER=clpr
DB_PASSWORD=
DB_SSLMODE=disable
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INSECURE_SKIP_VERIFY=false

# Generate an RSA key pair; never paste production keys into this template.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=
# Generate with: openssl rand -hex 32
OPERATIONAL_AUTH_TOKEN=

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8080/api/v1/auth/twitch/callback
# Separate callback used by the authenticated platform/bot authorization flow.
TWITCH_PLATFORM_REDIRECT_URI=http://localhost:8080/api/v1/twitch/oauth/callback
# Dedicated Twitch account used by the IRC clip-link listener. The token needs chat:read.
TWITCH_BOT_USERNAME=clpr_bot
TWITCH_BOT_OAUTH_TOKEN=

CLIP_STORAGE_PROVIDER=local
CLIP_STORAGE_ENDPOINT=
CLIP_STORAGE_BUCKET=clpr-local
CLIP_STORAGE_REGION=local
CLIP_STORAGE_ACCESS_KEY=
CLIP_STORAGE_SECRET_KEY=
CLIP_STORAGE_PUBLIC_BASE_URL=http://localhost:8080/media
CLIP_MEDIA_PUBLIC_BASE_URL=http://localhost:8080/media
CLIP_ALLOWED_UPLOAD_MIME_TYPES=video/mp4,video/webm

# Incomplete or credentialed features stay off in the default profile.
# Ranking rollout only; observation collection continues when false.
FEATURE_RECENT_ENGAGEMENT=false
FEATURE_ANALYTICS=false
FEATURE_EMAIL_NOTIFICATIONS=false
FEATURE_PUSH_NOTIFICATIONS=false
FEATURE_SEMANTIC_SEARCH=false
FEATURE_DISCOVERY_LISTS=false
FEATURE_MODERATION=true

# Uppies are reputation/status only and do not gate clip submissions.
KARMA_SUBMISSION_REQUIRED=0
KARMA_REQUIRE_FOR_SUBMISSION=false

EMAIL_ENABLED=false
EMAIL_SANDBOX_MODE=true
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_PUBLIC_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=clpr

EMBEDDING_ENABLED=false
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# OpenAI-compatible thumbnail enrichment. VISION_CREATED_AFTER is required
# when enabled so routine scheduling never turns into an implicit backfill.
VISION_ENABLED=false
VISION_PROVIDER=openai
VISION_API_KEY=
VISION_API_URL=
VISION_MODEL=
VISION_TIMEOUT_SECONDS=60
VISION_BATCH_SIZE=1
VISION_CREATED_AFTER=

# Authorized Twitch clip transcription. Streamers must grant channel:manage:clips.
WHISPER_ENABLED=false
WHISPER_PYTHON_PATH=/usr/local/bin/python3
WHISPER_RUNNER_DIR=/app/whisper
WHISPER_FFMPEG_PATH=/usr/bin/ffmpeg
WHISPER_WORK_DIR=/tmp/clpr-transcriptions
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

SENTRY_ENABLED=false
SENTRY_DSN=
TELEMETRY_OTLP_ENDPOINT=
TELEMETRY_ENVIRONMENT=development
TELEMETRY_SERVICE_NAME=clpr-api
# Background automation
AUTO_TAG_INTERVAL_SECONDS=30
AUTO_TAG_START_DELAY_SECONDS=15
TAG_PROMOTION_INTERVAL_MINUTES=15
TAG_PROMOTION_START_DELAY_SECONDS=90
TRENDING_SCORE_INTERVAL_MINUTES=60
TRENDING_SCORE_BATCH_SIZE=1000
TRENDING_START_DELAY_SECONDS=420
HOT_CLIPS_REFRESH_INTERVAL_MINUTES=5
HOT_SCORE_START_DELAY_SECONDS=120
PLAYLIST_START_DELAY_SECONDS=240
EMBEDDING_START_DELAY_SECONDS=720
