# Multi-stage Dockerfile for clip discovery crawler

# Build stage
FROM golang:1.26.5-alpine@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2 AS builder

RUN apk add --no-cache git

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -ldflags '-extldflags "-static"' -o /app/bin/scraper ./scripts/scrape_clips.go

# Final stage
FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce

RUN apk --no-cache add ca-certificates

RUN addgroup -S -g 10001 clpr && adduser -S -D -H -u 10001 -G clpr clpr \
    && mkdir -p /app && chown -R clpr:clpr /app

WORKDIR /app

COPY --from=builder --chown=clpr:clpr /app/bin/scraper .
COPY --chown=clpr:clpr --chmod=0555 scripts/crawler-entrypoint.sh .

USER 10001:10001

# Default: run every 30 minutes
ENV SCRAPE_INTERVAL=1800
ENV SCRAPE_MIN_VIEWS=50
ENV SCRAPE_MAX_AGE_DAYS=7
ENV SCRAPE_BATCH_SIZE=50
ENV SCRAPE_BROADCASTERS=""

CMD ["./crawler-entrypoint.sh"]
