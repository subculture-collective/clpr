# Render host worker for countdown videos (#77, #78; ADR-002). It holds clip
# media only in its own volume and deletes it within 24 hours. Run it on the
# render host (Almaz or Kvant), never on Dozor or the API host.

# Build stage
FROM golang:1.26.11-alpine@sha256:ae52b5bc6ed045a9ed26ab03dc19327a802a9cc9aa8b27ed57f5c6b60579b0bb AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags '-s -w' -o /app/bin/countdown-media ./cmd/countdown-media \
    && CGO_ENABLED=0 GOOS=linux go test -c -o /app/bin/countdownrender.test ./internal/countdownrender

# Runtime base: ffmpeg, yt-dlp, the fonts the render template names, and the
# faster-whisper runtime for Short captions (#81). Debian rather than Alpine:
# faster-whisper's wheels need glibc, and drawtext's text_align needs ffmpeg
# 6.1 or later, which bookworm does not have.
FROM python:3.12-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b AS runtime

# yt-dlp follows Twitch player changes; bump its pin and rebuild to update it.
# PyAV 19 dropped an argument faster-whisper 1.2.0 passes, so av is pinned.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates ffmpeg zlib1g fonts-noto-cjk \
    && pip install --no-cache-dir yt-dlp==2026.10.26 faster-whisper==1.2.0 av==18.1.0 requests==2.34.2 \
    && rm -rf /var/lib/apt/lists/*

# The golden-frame tests run against this exact ffmpeg and these fonts, so the
# image cannot be built when renders drift. To regenerate the goldens, run the
# test binary in this stage with UPDATE_GOLDEN=1 and the source testdata
# directory mounted at /test/testdata.
FROM runtime AS render-test
WORKDIR /test
COPY --from=builder /app/internal/countdownrender/testdata ./testdata
COPY --from=builder /app/bin/countdownrender.test ./
RUN ./countdownrender.test -test.v -test.count=1 > /test/result.txt 2>&1 || (cat /test/result.txt; exit 1)

# Final stage
FROM runtime

ARG OCI_REVISION=unknown
ARG OCI_SOURCE=https://git.subcult.tv/subculture-collective/clpr
LABEL org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.source="${OCI_SOURCE}"

RUN groupadd --system --gid 10001 clpr \
    && useradd --system --uid 10001 --gid 10001 --no-create-home clpr \
    && mkdir -p /var/lib/clpr-countdown-media /var/lib/clpr-countdown-renders /var/lib/clpr-whisper-models \
    && chown clpr:clpr /var/lib/clpr-countdown-media /var/lib/clpr-countdown-renders /var/lib/clpr-whisper-models \
    && chmod 0700 /var/lib/clpr-countdown-media /var/lib/clpr-countdown-renders /var/lib/clpr-whisper-models

COPY --from=render-test /test/result.txt /usr/share/doc/clpr-render/golden-test-result.txt
COPY --from=builder --chown=clpr:clpr /app/bin/countdown-media /usr/local/bin/countdown-media
COPY --from=builder /app/whisper /opt/clpr/whisper

USER 10001:10001

ENV COUNTDOWN_MEDIA_DIR=/var/lib/clpr-countdown-media \
    COUNTDOWN_RENDER_DIR=/var/lib/clpr-countdown-renders \
    WHISPER_PYTHON_PATH=/usr/local/bin/python3 \
    WHISPER_RUNNER_DIR=/opt/clpr/whisper \
    WHISPER_MODEL_DIR=/var/lib/clpr-whisper-models \
    HF_HOME=/var/lib/clpr-whisper-models/huggingface \
    XDG_CACHE_HOME=/var/lib/clpr-whisper-models/cache
VOLUME ["/var/lib/clpr-countdown-media", "/var/lib/clpr-countdown-renders"]
EXPOSE 9464

CMD ["countdown-media"]
