{
  "name": "clpr",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs && node scripts/prerender-info.mjs && npm run bundle:check",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "boundaries:check": "node scripts/check-ui-boundaries.mjs",
    "routes:check": "node scripts/generate-edge-routes.mjs --check",
    "routes:manifest": "node scripts/generate-edge-routes.mjs --write-manifest",
    "routes:nginx": "node scripts/generate-edge-routes.mjs --nginx-output edge-routes.conf",
    "build:analyze": "node scripts/build.mjs --mode analyze",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:inventory": "node scripts/verify-test-pyramid.mjs",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:e2e:mocked": "playwright test --project=mocked-chromium",
    "test:e2e:real": "playwright test --project=real-chromium --project=real-firefox --project=real-webkit",
    "test:e2e:candidate": "playwright test --config=playwright.candidate.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "code:unused": "node scripts/check-unused-source.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check": "npm run typecheck && npm run lint && npm run code:unused && npm run test:inventory && npm run test:coverage && npm run test:coverage:verify",
    "test:coverage:verify": "node scripts/verify-critical-coverage.mjs"
  },
  "dependencies": {
    "@dr.pogodin/react-helmet": "^3.3.2",
    "@sentry/react": "^10.78.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "3.14.26",
    "axios": "^1.21.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "hls.js": "^1.7.4",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.3.0",
    "idb": "^8.0.4",
    "lucide-react": "^0.577.0",
    "posthog-js": "^1.447.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^16.6.6",
    "react-intersection-observer": "^10.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/dompurify": "^3.2.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "autoprefixer": "^10.6.2",
    "axe-core": "^4.14.0",
    "baseline-browser-mapping": "^2.11.35",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.8",
    "globals": "^16.5.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^27.1.0",
    "msw": "^2.15.0",
    "postcss": "^8.5.32",
    "rolldown": "1.3.0",
    "rollup-plugin-visualizer": "^6.0.11",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.1.12"
  }
}
